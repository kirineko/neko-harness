{
	"name": "neko-harness",
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"build": "pnpm -r run build",
		"check": "biome check . && tsc --noEmit && pnpm --filter @neko-harness/web run check:client",
		"check:write": "biome check --write . && tsc --noEmit && pnpm --filter @neko-harness/web run check:client",
		"test": "vitest run",
		"test:serial": "vitest run --no-file-parallelism",
		"neko": "node --conditions=neko-source packages/cli/src/bin.ts",
		"build:release": "pnpm build && node scripts/build-release.ts",
		"test:package": "node scripts/test-package.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.20.5",
		"qrcode-generator": "2.0.4",
		"rolldown": "1.2.19",
		"typescript": "7.0.2",
		"vitest": "5.1.0"
	},
	"packageManager": "pnpm@10.33.2",
	"version": "0.5.5",
	"description": "A local AI coding assistant with terminal and web interfaces, powered by Pi and Node.js.",
	"keywords": [
		"ai",
		"agent",
		"coding-assistant",
		"cli",
		"tui",
		"web-ui",
		"node",
		"pi"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kirineko/neko-harness.git"
	},
	"homepage": "https://github.com/kirineko/neko-harness#readme",
	"bugs": {
		"url": "https://github.com/kirineko/neko-harness/issues"
	},
	"bin": {
		"neko": "dist/neko.js"
	},
	"files": [
		"dist/",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public",
		"tag": "latest",
		"registry": "https://registry.npmjs.org"
	},
	"dependencies": {
		"@earendil-works/chord": "1.5.0",
		"@earendil-works/pi-ai": "1.5.0",
		"@earendil-works/pi-codemode": "1.5.0",
		"@earendil-works/pi-durable": "1.5.0",
		"@earendil-works/pi-env": "1.5.0",
		"@earendil-works/pi-schema": "1.5.0",
		"@earendil-works/pi-tui": "1.5.0",
		"sharp": "0.35.5",
		"ws": "8.21.0",
		"yaml": "2.9.1"
	}
}
