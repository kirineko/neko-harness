{
	"name": "neko-harness",
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"engines": {
		"bun": ">=1.4.0 <1.5.0"
	},
	"scripts": {
		"build": "bun run --cwd packages/core build && bun run --cwd packages/gateway build && bun run --cwd packages/tui build && bun run --cwd packages/web build && bun run --cwd packages/cli build",
		"check": "bun --bun run biome check . && bun --bun run tsc --noEmit && bun run --cwd packages/web check:client",
		"check:write": "bun --bun run biome check --write . && bun --bun run tsc --noEmit && bun run --cwd packages/web check:client",
		"test": "bun test --conditions=neko-source --parallel",
		"test:serial": "bun test --conditions=neko-source --isolate",
		"neko": "bun --conditions=neko-source packages/cli/src/main.ts",
		"build:release": "bun run build && bun scripts/build-release.ts",
		"test:package": "bun scripts/test-package.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/bun": "1.4.3",
		"@types/node": "22.20.5",
		"qrcode-generator": "2.0.4",
		"typescript": "7.0.2"
	},
	"packageManager": "bun@1.4.4",
	"trustedDependencies": [],
	"version": "0.5.1",
	"description": "A local AI coding assistant with terminal and web interfaces, powered by Pi and Bun.",
	"keywords": [
		"ai",
		"agent",
		"coding-assistant",
		"cli",
		"tui",
		"web-ui",
		"bun",
		"pi"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kirineko/neko-harness.git"
	},
	"homepage": "https://github.com/kirineko/neko-harness#readme",
	"bugs": {
		"url": "https://github.com/kirineko/neko-harness/issues"
	},
	"bin": {
		"neko": "dist/neko.js"
	},
	"files": [
		"dist/",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public",
		"tag": "latest",
		"registry": "https://registry.npmjs.org"
	},
	"dependencies": {
		"@earendil-works/chord": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-durable": "1.4.0",
		"@earendil-works/pi-tui": "1.4.0",
		"sharp": "0.35.5",
		"ws": "8.22.0",
		"yaml": "2.9.1",
		"@earendil-works/pi-env": "1.4.0",
		"typebox": "1.3.27"
	}
}
