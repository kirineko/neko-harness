{
	"name": "@neko-harness/web",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"neko-source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./cli": {
			"neko-source": "./src/main.ts",
			"import": "./dist/main.js"
		}
	},
	"scripts": {
		"build": "bun --bun run tsc -p tsconfig.client.json --noEmit && bun --bun run tsc -p tsconfig.build.json && bun --bun run vite build",
		"check:client": "bun --bun run tsc -p tsconfig.client.json --noEmit && bun --bun run tsc -p tsconfig.test.json --noEmit",
		"dev": "bun --bun run vite"
	},
	"dependencies": {
		"@earendil-works/chord": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@floating-ui/react": "0.27.20",
		"@neko-harness/core": "workspace:*",
		"@neko-harness/gateway": "workspace:*",
		"highlight.js": "11.12.0",
		"katex": "0.19.0",
		"qrcode-generator": "2.0.4"
	},
	"devDependencies": {
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/react-router": "1.170.42",
		"@types/jsdom": "30.0.0",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/ws": "8.18.2",
		"@vitejs/plugin-react": "6.1.2",
		"dompurify": "3.4.16",
		"jsdom": "30.1.3",
		"marked": "18.1.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"tailwindcss": "4.3.3",
		"vite": "8.3.4"
	}
}
