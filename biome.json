{
	"$schema": "https://biomejs.dev/schemas/2.3.5/schema.json",
	"files": {
		"includes": [
			"scripts/**/*.ts",
			"packages/*/src/**/*.ts",
			"packages/*/src/**/*.tsx",
			"packages/*/test/**/*.ts",
			"packages/*/test/**/*.tsx",
			"packages/*/examples/**/*.ts",
			"packages/web/vite.config.ts",
			"!reference"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noNonNullAssertion": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 120,
		"lineEnding": "auto"
	}
}
